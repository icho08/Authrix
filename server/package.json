{
  "name": "tala-server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "bun --watch index.ts",
    "dev:local": "bun run index.ts",
    "seed": "bun run prisma/seed.ts",
    "vercel-build": "prisma generate && tsc",
    "npm:build": "npm run prisma:generate && npm run compile",
    "npm:start": "node dist /index.js",
    "npm:dev": "ts-node --esm index.ts",
    "compile": "tsc",
    "prisma:generate": "prisma generate"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.5",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nanoid": "^3.0.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.6",
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "geoip-lite": "^1.4.10",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "prisma": "^6.19.0",
    "resend": "^6.4.2",
    "ua-parser-js": "^2.0.6",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
